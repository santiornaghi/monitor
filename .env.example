# Copiar a .env.local y completar con los datos de Supabase (botón Connect o Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# URL pública de la app para los QR. En Vercel no hace falta: se usa el dominio de producción.
# Cuando tengas dominio propio, cargá SITE_URL (sin NEXT_PUBLIC_) en Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
